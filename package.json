{
  "name": "my-archive",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle.prod.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx scripts/db-check.ts",
    "db:check:prod": "tsx scripts/db-check.ts --prod",
    "owner:create": "tsx scripts/create-owner.ts",
    "owner:create:prod": "tsx scripts/create-owner.ts --prod",
    "owner:reset-password": "tsx scripts/create-owner.ts --reset-password",
    "owner:reset-password:prod": "tsx scripts/create-owner.ts --reset-password --prod",
    "pin:hash": "tsx scripts/hash-pin.ts",
    "gen-secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@next/env": "^16.0.0",
    "better-auth": "^1.3.27",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^0.544.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.0.0",
    "pg": "^8.16.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
